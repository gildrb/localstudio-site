{
  "name": "@local-ai/logo-renderer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "exports": {
    "./react": "./src/renderer/index.tsx"
  },
  "scripts": {
    "typecheck": "bun x --bun tsc -p tsconfig.json",
    "generate": "bun scripts/generate-logo-mesh.mjs",
    "generate:cta": "bun scripts/generate-cta-mesh.mjs",
    "check": "bun scripts/generate-logo-mesh.mjs --check && bun scripts/generate-cta-mesh.mjs --check",
    "shader:check": "bun scripts/check-shaders.mjs",
    "snapshot": "bun scripts/render-snapshot.mjs"
  },
  "peerDependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "dependencies": {
    "@stylexjs/stylex": "0.19.0",
    "phase": "0.0.1",
    "vgpu": "0.3.1"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "clipper-lib": "6.4.2",
    "earcut": "3.2.3",
    "typescript": "6.0.3"
  }
}
