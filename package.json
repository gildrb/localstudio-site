{
	"name": "localstudio-landing",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"packageManager": "bun@1.3.14",
	"workspaces": [
		"packages/*"
	],
	"patchedDependencies": {
		"vgpu@0.3.1": "patches/vgpu@0.3.1.patch"
	},
	"overrides": {
		"rolldown": "1.2.4"
	},
	"engines": {
		"bun": ">=1.3.14"
	},
	"scripts": {
		"dev": "vite",
		"dev:lan": "vite --host 0.0.0.0",
		"build": "bun run packages:check && tsc -b && vite build && node scripts/prerender.mjs && node scripts/stylex-check.mjs --dist",
		"lint": "eslint . && oxlint .",
		"generated:check": "bun scripts/verify-generated.mjs",
		"preview": "vite preview",
		"test": "playwright test",
		"test:unit": "bun test tests/unit",
		"test:visual": "playwright test --config playwright.visual.config.ts",
		"context:report": "bun scripts/context.mjs report",
		"context:bundle": "bun scripts/context.mjs bundle",
		"context:check": "bun scripts/context.mjs check",
		"graph:report": "bun scripts/graph.mjs report",
		"graph:check": "bun scripts/graph.mjs check",
		"check": "bun run lint && tsc -b && bun run packages:check && bun run context:check && bun run graph:check && bun run generated:check && bun run stylex:check && bun run test:unit",
		"design:manifest": "bun scripts/design-manifest.mjs write",
		"design:manifest:check": "bun scripts/design-manifest.mjs check",
		"reproducible:check": "bun scripts/reproducible.mjs",
		"assets:manifest": "bun scripts/assets.mjs write",
		"assets:check": "bun scripts/assets.mjs check",
		"bundle:check": "bun scripts/bundle.mjs check",
		"bundle:report": "bun scripts/bundle.mjs report",
		"vercel:manifest": "bun scripts/vercel.mjs write",
		"vercel:check": "bun scripts/vercel.mjs check",
		"index:html": "bun scripts/index-html.mjs write",
		"index:html:check": "bun scripts/index-html.mjs check",
		"packages:check": "bun run --filter './packages/*' typecheck && bun run --cwd packages/logo-renderer shader:check",
		"logo:check": "bun run --filter @local-ai/logo-renderer check",
		"stylex:check": "node scripts/stylex-check.mjs"
	},
	"dependencies": {
		"@stylexjs/stylex": "0.19.0",
		"@vgpu/wgsl": "0.3.1",
		"lucide-react": "1.31.0",
		"motion": "13.1.0",
		"react": "19.2.8",
		"react-dom": "19.2.8"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@oxlint/plugins": "1.78.0",
		"@playwright/test": "1.62.1",
		"@stylexjs/eslint-plugin": "0.19.0",
		"@stylexjs/unplugin": "0.19.0",
		"@types/node": "26.2.0",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.4",
		"@vitejs/plugin-react": "6.0.5",
		"eslint": "10.8.1",
		"eslint-plugin-react-hooks": "7.1.1",
		"eslint-plugin-react-refresh": "0.5.4",
		"globals": "17.11.0",
		"oxlint": "1.78.0",
		"typescript": "6.0.3",
		"typescript-eslint": "8.67.0",
		"vite": "8.2.1"
	}
}
