{
	"name": "localstudio-landing",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"generated:check": "vp run design:manifest:check && vp run assets:check && vp run vercel:check && vp run index:html:check && vp run logo:check",
		"design:manifest": "node scripts/design-manifest.ts write",
		"design:manifest:check": "node scripts/design-manifest.ts check",
		"reproducible:check": "node scripts/reproducible.ts",
		"assets:manifest": "node scripts/assets.ts write",
		"assets:check": "node scripts/assets.ts check",
		"bundle:check": "node scripts/bundle.ts check",
		"bundle:report": "node scripts/bundle.ts report",
		"vercel:manifest": "node scripts/vercel.ts write",
		"vercel:check": "node scripts/vercel.ts check",
		"index:html": "node scripts/index-html.ts write",
		"index:html:check": "node scripts/index-html.ts check",
		"test:e2e": "playwright test",
		"test:visual": "playwright test --config playwright.visual.config.ts",
		"styles:check": "node scripts/check-styles.ts",
		"validate": "vp run generated:check && vp run --filter @local-ai/logo-renderer shader:check",
		"logo:check": "vp run --filter @local-ai/logo-renderer check",
		"snapshot": "vp pack && node packages/logo-renderer/node_modules/.cache/render/render-snapshot.mjs",
		"snapshot:atmosphere": "vp pack && node packages/logo-renderer/node_modules/.cache/render/render-atmosphere.mjs",
		"snapshot:loading-layers": "node packages/logo-renderer/scripts/render-loading-layers.ts"
	},
	"dependencies": {
		"@local-ai/logo-renderer": "workspace:*",
		"@local-studio/demo-ui": "workspace:*",
		"@stylexjs/stylex": "0.19.0",
		"@tabler/icons-react": "3.46.0",
		"motion": "13.2.0",
		"preact": "10.29.8",
		"preact-render-to-string": "6.7.0",
		"valibot": "1.5.0"
	},
	"devDependencies": {
		"@playwright/test": "1.63.0",
		"@stylexjs/unplugin": "0.19.0",
		"@types/node": "26.5.1",
		"@vgpu/wgsl": "0.4.1",
		"typescript": "7.0.2",
		"vgpu": "0.4.1",
		"vite": "npm:@voidzero-dev/vite-plus-core@0.3.1",
		"vite-plus": "0.3.1"
	},
	"engines": {
		"node": ">=24.11.0"
	}
}
