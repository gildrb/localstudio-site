{
  "name": "localstudio-landing",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . && oxlint .",
    "design:sync": "node scripts/sync-ls-demo-styles.mjs",
    "design:check": "node scripts/sync-ls-demo-styles.mjs --check",
    "generated:check": "node scripts/verify-generated.mjs",
    "preview": "vite preview",
    "test": "playwright test",
    "doctor": "npx --yes react-doctor@0.4.0",
    "context:report": "node scripts/context.mjs report",
    "context:bundle": "node scripts/context.mjs bundle",
    "context:check": "node scripts/context.mjs check",
    "graph:report": "node scripts/graph.mjs report",
    "graph:check": "node scripts/graph.mjs check",
    "check": "pnpm lint && pnpm exec tsc -b && pnpm context:check && pnpm graph:check && pnpm design:check && pnpm generated:check"
  },
  "dependencies": {
    "@vgpu/core": "0.0.7",
    "@vgpu/render": "0.0.7",
    "@vgpu/wgsl": "0.0.7",
    "lucide-react": "1.31.0",
    "motion": "13.1.0",
    "phase": "0.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@oxlint/plugins": "1.78.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@webgpu/types": "0.1.69",
    "earcut": "3.2.3",
    "eslint": "10.8.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "globals": "17.11.0",
    "oxlint": "1.78.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1"
  },
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  }
}
