{
	"name": "localstudio-landing",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"generated:check": "vp exec node scripts/verify-generated.ts",
		"context:report": "vp exec node scripts/context.ts report",
		"context:bundle": "vp exec node scripts/context.ts bundle",
		"context:check": "vp exec node scripts/context.ts check",
		"graph:report": "vp exec node scripts/graph.ts report",
		"graph:check": "vp exec node scripts/graph.ts check",
		"design:manifest": "vp exec node scripts/design-manifest.ts write",
		"design:manifest:check": "vp exec node scripts/design-manifest.ts check",
		"reproducible:check": "vp exec node scripts/reproducible.ts",
		"assets:manifest": "vp exec node scripts/assets.ts write",
		"assets:check": "vp exec node scripts/assets.ts check",
		"bundle:check": "vp exec node scripts/bundle.ts check",
		"bundle:report": "vp exec node scripts/bundle.ts report",
		"vercel:manifest": "vp exec node scripts/vercel.ts write",
		"vercel:check": "vp exec node scripts/vercel.ts check",
		"index:html": "vp exec node scripts/index-html.ts write",
		"index:html:check": "vp exec node scripts/index-html.ts check",
		"test:e2e": "vp exec playwright test",
		"test:visual": "vp exec playwright test --config playwright.visual.config.ts",
		"styles:check": "vp exec node scripts/check-styles.ts",
		"validate": "vp run context:check && vp run graph:check && vp run generated:check && vp run styles:check && vp run --filter @local-ai/logo-renderer shader:check",
		"logo:check": "vp run --filter @local-ai/logo-renderer check",
		"snapshot": "vp pack && vp exec node packages/logo-renderer/node_modules/.cache/render/render-snapshot.mjs",
		"snapshot:atmosphere": "vp pack && vp exec node packages/logo-renderer/node_modules/.cache/render/render-atmosphere.mjs",
		"snapshot:loading-layers": "vp exec node packages/logo-renderer/scripts/render-loading-layers.ts"
	},
	"dependencies": {
		"@local-ai/logo-renderer": "workspace:*",
		"@local-studio/demo-ui": "workspace:*",
		"@stylexjs/stylex": "0.19.0",
		"lucide-react": "1.44.0",
		"motion": "13.2.0",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"valibot": "1.5.0"
	},
	"devDependencies": {
		"@oxlint/plugins": "1.79.0",
		"@playwright/test": "1.63.0",
		"@stylexjs/unplugin": "0.19.0",
		"@types/node": "26.5.1",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vgpu/wgsl": "0.4.1",
		"@vitejs/plugin-react": "6.1.1",
		"typescript": "7.0.2",
		"vgpu": "0.4.1",
		"vite": "npm:@voidzero-dev/vite-plus-core@0.3.1",
		"vite-plus": "0.3.1",
		"yaml": "2.9.0"
	},
	"engines": {
		"node": ">=24.11.0"
	}
}
