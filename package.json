{
	"name": "localstudio-landing",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"generated:check": "vp exec node scripts/verify-generated.mjs",
		"context:report": "vp exec node scripts/context.mjs report",
		"context:bundle": "vp exec node scripts/context.mjs bundle",
		"context:check": "vp exec node scripts/context.mjs check",
		"graph:report": "vp exec node scripts/graph.mjs report",
		"graph:check": "vp exec node scripts/graph.mjs check",
		"design:manifest": "vp exec node scripts/design-manifest.mjs write",
		"design:manifest:check": "vp exec node scripts/design-manifest.mjs check",
		"reproducible:check": "vp exec node scripts/reproducible.mjs",
		"assets:manifest": "vp exec node scripts/assets.mjs write",
		"assets:check": "vp exec node scripts/assets.mjs check",
		"bundle:check": "vp exec node scripts/bundle.mjs check",
		"bundle:report": "vp exec node scripts/bundle.mjs report",
		"vercel:manifest": "vp exec node scripts/vercel.mjs write",
		"vercel:check": "vp exec node scripts/vercel.mjs check",
		"index:html": "vp exec node scripts/index-html.mjs write",
		"index:html:check": "vp exec node scripts/index-html.mjs check",
		"test:e2e": "vp exec playwright test",
		"test:visual": "vp exec playwright test --config playwright.visual.config.ts",
		"styles:check": "vp exec node scripts/check-styles.mjs",
		"validate": "vp run context:check && vp run graph:check && vp run generated:check && vp run styles:check && vp run --filter @local-ai/logo-renderer shader:check",
		"logo:check": "vp run --filter @local-ai/logo-renderer check",
		"snapshot": "vp pack && vp exec node packages/logo-renderer/node_modules/.cache/render/render-snapshot.mjs",
		"snapshot:atmosphere": "vp pack && vp exec node packages/logo-renderer/node_modules/.cache/render/render-atmosphere.mjs",
		"snapshot:loading-layers": "vp exec node packages/logo-renderer/scripts/render-loading-layers.mjs"
	},
	"dependencies": {
		"@local-ai/logo-renderer": "workspace:*",
		"@local-studio/demo-ui": "workspace:*",
		"@stylexjs/stylex": "0.19.0",
		"lucide-react": "1.31.0",
		"motion": "13.1.0",
		"react": "19.2.8",
		"react-dom": "19.2.8"
	},
	"devDependencies": {
		"@oxlint/plugins": "1.79.0",
		"@playwright/test": "1.62.1",
		"@stylexjs/unplugin": "0.19.0",
		"@types/node": "26.2.0",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.4",
		"@vgpu/wgsl": "0.3.1",
		"@vitejs/plugin-react": "6.1.1",
		"typescript": "6.0.3",
		"vgpu": "0.3.1",
		"vite": "npm:@voidzero-dev/vite-plus-core@0.3.1",
		"vite-plus": "0.3.1",
		"yaml": "2.9.0"
	},
	"engines": {
		"node": ">=24.11.0"
	}
}
